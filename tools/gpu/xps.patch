diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a5..64f8adc 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2484,10 +2484,24 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
       vfetch_bits_remaining &= ~(uint32_t(1) << j);
       uint32_t vfetch_index = i * 32 + j;
       uint64_t vfetch_bit = uint64_t(1) << (vfetch_index & 63);
+      // The pinned runtime does not watch writes through the XPS alias.
+      // Re-upload these small CPU scratch buffers on each draw until the
+      // runtime gains a physical heap and write watches for that alias.
+      const auto scratch_fetch = regs.GetVertexFetch(vfetch_index);
+      if ((scratch_fetch.address << 2) >= 0xC0000000u &&
+          (scratch_fetch.address << 2) < 0xC1000000u) {
+        shared_memory_->MemoryInvalidationCallback(
+            (scratch_fetch.address << 2) & 0x1FFFFFFFu,
+            scratch_fetch.size << 2, true);
+        vertex_buffers_in_sync_[vfetch_index >> 6] &= ~vfetch_bit;
+        vertex_buffer_states_[vfetch_index].address = UINT32_MAX;
+      }
       if (vertex_buffers_in_sync_[vfetch_index >> 6] & vfetch_bit) {
         continue;
       }
       xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(vfetch_index);
+      // Wrap writeback/XPS aliases to their 512 MiB physical backing.
+      vfetch_constant.address &= 0x07FFFFFF;
       switch (vfetch_constant.type) {
         case xenos::FetchConstantType::kVertex:
           break;
