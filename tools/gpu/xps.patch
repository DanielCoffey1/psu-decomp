+void D3D12CommandProcessor::CapturePsuMovieFrame() {
+  const auto& regs = *register_file_;
+  const auto y = regs.GetTextureFetch(0);
+  const auto u = regs.GetTextureFetch(1);
+  const auto v = regs.GetTextureFetch(2);
+  const uint32_t width = uint32_t(y.size_2d.width) + 1;
+  const uint32_t height = uint32_t(y.size_2d.height) + 1;
+  if (width < 2 || height < 2 || width > 1920 || height > 1080 ||
+      (width & 1) || (height & 1)) return;
+  const xenos::xe_gpu_texture_fetch_t planes[] = {y, u, v};
+  const uint8_t* pixels[3];
+  uint32_t pitches[3];
+  for (uint32_t i = 0; i < 3; ++i) {
+    const auto& f = planes[i];
+    const uint32_t w = i ? width / 2 : width;
+    const uint32_t h = i ? height / 2 : height;
+    const uint32_t address = (uint32_t(f.base_address) << 12) & 0x1FFFFFFFu;
+    pitches[i] = uint32_t(f.pitch) << 5;
+    if (f.format != xenos::TextureFormat::k_8 || f.tiled || uint32_t(f.endianness) ||
+        uint32_t(f.size_2d.width) + 1 != w || uint32_t(f.size_2d.height) + 1 != h ||
+        pitches[i] < w || uint64_t(address) + uint64_t(pitches[i]) * h > 0x20000000ull) return;
+    pixels[i] = memory_->TranslatePhysical<const uint8_t*>(address);
+  }
+  // Use the game's conversion constants, including any color adjustment.
+  const float* bias = reinterpret_cast<const float*>(&regs[XE_GPU_REG_SHADER_CONSTANT_510_X]);
+  const float* scale = reinterpret_cast<const float*>(&regs[XE_GPU_REG_SHADER_CONSTANT_511_X]);
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!std::isfinite(bias[i]) || !std::isfinite(scale[i])) return;
+  }
+  float luma[256], red_v[256], blue_u[256], green_u[256], green_v[256];
+  for (uint32_t i = 0; i < 256; ++i) {
+    luma[i] = (float(i) / 255.0f + bias[0]) * scale[0];
+    const float chroma = float(i) / 255.0f + bias[1];
+    red_v[i] = chroma * scale[2] + bias[2];
+    blue_u[i] = chroma * scale[1] + bias[2];
+    green_u[i] = -chroma * bias[3];
+    green_v[i] = -chroma * scale[3];
+  }
+  psu_movie_rgba_.resize(size_t(width) * height * 4);
+  auto channel = [](float value) -> uint8_t {
+    return uint8_t(std::clamp(value * 255.0f + 0.5f, 0.0f, 255.0f));
+  };
+  for (uint32_t row = 0; row < height; ++row) {
+    const auto* yy = pixels[0] + row * pitches[0];
+    const auto* uu = pixels[1] + (row / 2) * pitches[1];
+    const auto* vv = pixels[2] + (row / 2) * pitches[2];
+    auto* dest = psu_movie_rgba_.data() + size_t(row) * width * 4;
+    for (uint32_t x = 0; x < width; ++x) {
+      const float value = luma[yy[x]];
+      dest[x * 4] = channel(value + red_v[vv[x / 2]]);
+      dest[x * 4 + 1] = channel(value + green_u[uu[x / 2]] + green_v[vv[x / 2]]);
+      dest[x * 4 + 2] = channel(value + blue_u[uu[x / 2]]);
+      dest[x * 4 + 3] = 255;
+    }
+  }
+  psu_movie_width_ = width;
+  psu_movie_height_ = height;
+  psu_movie_pending_ = true;
+}
