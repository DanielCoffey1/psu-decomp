+ID3D12Resource* D3D12CommandProcessor::UploadPsuMovieFrame() {
+  if (!psu_movie_pending_) return nullptr;
+  psu_movie_pending_ = false;
+  auto& provider = GetD3D12Provider();
+  if (!psu_movie_upload_pool_) {
+    psu_movie_upload_pool_ = std::make_unique<ui::d3d12::D3D12UploadBufferPool>(provider, 8 * 1024 * 1024);
+  }
+  psu_movie_upload_pool_->Reclaim(frame_completed_);
+  if (psu_movie_texture_ &&
+      (psu_movie_texture_->GetDesc().Width != psu_movie_width_ ||
+       psu_movie_texture_->GetDesc().Height != psu_movie_height_)) {
+    resources_for_deletion_.emplace_back(submission_current_, psu_movie_texture_.Detach());
+  }
+  if (!psu_movie_texture_) {
+    D3D12_HEAP_PROPERTIES heap = {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = psu_movie_width_;
+    desc.Height = psu_movie_height_;
+    desc.DepthOrArraySize = desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    if (FAILED(provider.GetDevice()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE,
+        &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&psu_movie_texture_)))) return nullptr;
+    psu_movie_texture_state_ = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  const uint32_t pitch = (psu_movie_width_ * 4 + 255) & ~255u;
+  ID3D12Resource* upload = nullptr;
+  size_t offset = 0;
+  uint8_t* dest = psu_movie_upload_pool_->Request(frame_current_, size_t(pitch) * psu_movie_height_,
+      D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT, &upload, &offset, nullptr);
+  if (!dest) return nullptr;
+  for (uint32_t y = 0; y < psu_movie_height_; ++y) {
+    std::memcpy(dest + size_t(y) * pitch,
+        psu_movie_rgba_.data() + size_t(y) * psu_movie_width_ * 4, psu_movie_width_ * 4);
+  }
+  psu_movie_upload_pool_->FlushWrites();
+  PushTransitionBarrier(psu_movie_texture_.Get(), psu_movie_texture_state_, D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source = {}, target = {};
+  source.pResource = upload;
+  source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  source.PlacedFootprint.Offset = offset;
+  source.PlacedFootprint.Footprint = {DXGI_FORMAT_R8G8B8A8_UNORM, psu_movie_width_, psu_movie_height_, 1, pitch};
+  target.pResource = psu_movie_texture_.Get();
+  target.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  deferred_command_list_.D3DCopyTextureRegion(&target, 0, 0, 0, &source, nullptr);
+  PushTransitionBarrier(psu_movie_texture_.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  psu_movie_texture_state_ = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  return psu_movie_texture_.Get();
+}
